# TraceLattice MCP Server - Environment Variables Example
# Copy this file to .env and configure as needed.

# Optional explicit YAML or JSON configuration file.
# TRACELATTICE_CONFIG=./tracelattice.yaml

# Transport: stdio (default) or streamable-http.
TRACELATTICE_TRANSPORT_TYPE=streamable-http
TRACELATTICE_STREAMABLE_HTTP_PORT=9007
TRACELATTICE_STREAMABLE_HTTP_HOST=localhost

# Stateful Streamable HTTP uses the MCP-standard Mcp-Session-Id header.
TRACELATTICE_STREAMABLE_HTTP_STATEFUL=true
TRACELATTICE_CORS_ORIGIN=*
TRACELATTICE_ENABLE_CORS=true
# TRACELATTICE_ALLOWED_HOSTS=localhost,127.0.0.1

# Server limits.
TRACELATTICE_MAX_HISTORY_SIZE=10000
TRACELATTICE_MAX_BRANCHES=50
TRACELATTICE_MAX_BRANCH_SIZE=100
TRACELATTICE_SESSION_MAX_PER_OWNER=50

# Logging.
TRACELATTICE_LOG_LEVEL=info
TRACELATTICE_PRETTY_LOG=true

# Discovery roots and cache. TTL is expressed in seconds.
TRACELATTICE_SKILL_DIRS=.claude/skills:~/.claude/skills
TRACELATTICE_TOOL_DIRS=.claude/tools:~/.claude/tools
TRACELATTICE_DISCOVERY_CACHE_TTL=300
TRACELATTICE_DISCOVERY_CACHE_MAX_SIZE=100

# Feature flags default to enabled. Boolean values accept true/false/1/0.
TRACELATTICE_FEATURES_DAG_EDGES=true
TRACELATTICE_FEATURES_CALIBRATION=true
TRACELATTICE_FEATURES_COMPRESSION=true
TRACELATTICE_FEATURES_TOOL_INTERLEAVE=true
TRACELATTICE_FEATURES_NEW_THOUGHT_TYPES=true
TRACELATTICE_FEATURES_OUTCOME_RECORDING=true
TRACELATTICE_FEATURES_REASONING_STRATEGY=sequential

# Tool-interleave timing is expressed in milliseconds.
TRACELATTICE_TOOL_INTERLEAVE_TTL_MS=60000
TRACELATTICE_TOOL_INTERLEAVE_SWEEP_MS=60000

# File-watcher event logging is quiet unless explicitly enabled.
# TRACELATTICE_WATCHER_VERBOSE=true
