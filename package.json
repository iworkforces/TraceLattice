{
	"name": "@iworkforces/tracelattice",
	"version": "2.3.6",
	"description": "Semantic Sequential Thinking Layer For AI Agents.",
	"type": "module",
	"main": "dist/lib.js",
	"types": "dist/lib.d.ts",
	"exports": {
		".": {
			"types": "./dist/lib.d.ts",
			"import": "./dist/lib.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"tracelattice": "./dist/cli.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "rslib build && rsbuild build -c rsbuild.config.ts && node scripts/postbuild-cli.mjs",
		"build:lib": "rslib build",
		"build:cli": "rsbuild build -c rsbuild.config.ts && node scripts/postbuild-cli.mjs",
		"start": "bun dist/cli.js",
		"dev": "bunx @modelcontextprotocol/inspector dist/cli.js",
		"test": "vitest run --config vitest.config.ts",
		"test:watch": "vitest --config vitest.config.ts",
		"test:coverage": "vitest run --config vitest.config.ts --coverage",
		"test:native": "vitest run --config vitest.config.ts src/__tests__/integration/NativeSqliteConformance.test.ts",
		"lint": "eslint src/",
		"lint:fix": "eslint src/ --fix",
		"format": "prettier --write \"src/**/*.ts\" \"*.{json,md}\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md}\"",
		"type-check": "tsc --noEmit",
		"verify:library": "npm run type-check && npm run lint && npm run build && npm run test:coverage",
		"verify:native": "npm ls better-sqlite3@13.0.3 --depth=0 && npm run test:native",
		"verify:packed": "node scripts/verify-packed-cli.mjs",
		"verify:release": "npm run verify:library && npm run verify:native && npm run verify:packed",
		"prepublishOnly": "npm run verify:release"
	},
	"keywords": [
		"mcp",
		"model-context-protocol",
		"sequential-thinking",
		"problem-solving",
		"tool-recommendation",
		"decision-making",
		"thought-process",
		"step-by-step",
		"llm",
		"ai",
		"branching-thoughts",
		"thought-revision",
		"tool-analysis",
		"problem-breakdown",
		"solution-planning",
		"adaptive-thinking",
		"reflective-analysis",
		"tool-confidence"
	],
	"author": "CCWorkforces Engineers",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/iworkforces/TraceLattice"
	},
	"bugs": {
		"url": "https://github.com/iworkforces/TraceLattice/issues"
	},
	"homepage": "https://github.com/iworkforces/TraceLattice#readme",
	"dependencies": {
		"@tmcp/adapter-valibot": "^0.1.7",
		"@tmcp/transport-stdio": "^0.5.1",
		"@tsconfig/node26": "^26.0.2",
		"@valibot/to-json-schema": "^1.8.0",
		"chalk": "^6.0.1",
		"chokidar": "^6.0.0",
		"or": "^0.2.0",
		"tmcp": "^1.20.1",
		"valibot": "^1.5.0",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^10.0.1",
		"@rsbuild/core": "^2.3.2",
		"@rslib/core": "^1.0.7",
		"@types/node": "^26.6.6",
		"@typescript-eslint/eslint-plugin": "^8.72.2",
		"@typescript-eslint/parser": "^8.72.2",
		"@vitest/coverage-v8": "^5.1.0",
		"better-sqlite3": "13.1.1",
		"eslint": "^10.14.0",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.72.2",
		"vitest": "^5.1.0"
	},
	"allowScripts": {
		"fsevents@2.3.3": true,
		"better-sqlite3@13.1.1": true
	}
}
